# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, or any Postgres provider)
DATABASE_URL="postgresql://user:password@host:5432/njz_update?schema=public"

# ── NextAuth (Auth.js) ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave empty to disable Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── News ingestion cron ─────────────────────────────────────────────────
# Secret sent as `Authorization: Bearer <CRON_SECRET>` (or ?secret=) to /api/cron/fetch-updates.
# Also used by Vercel Cron. Generate with: openssl rand -hex 32
CRON_SECRET="change-me-to-a-long-random-secret"

# If false, fetched updates go to "Pending Review" and need admin approval
# before they appear publicly. If true, validated updates publish directly.
AUTO_PUBLISH="false"

# ── News ingestion ──────────────────────────────────────────────────────
# Optional: YouTube Data API v3 key, used only if you add a YouTube API-based
# source. (The plain YouTube channel RSS feed is disallowed by youtube.com's
# robots.txt, so the seeded YouTube source ships disabled.)
YOUTUBE_API_KEY=""

# ── Supabase (optional — realtime + storage) ────────────────────────────
# If set, the realtime layer uses Supabase Realtime channels; otherwise the
# app falls back to lightweight polling which works on any Vercel deploy.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="NJZ Update"
